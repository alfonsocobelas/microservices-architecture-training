{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/microservices-nestjs/src",
  "entryFile": "start",
  "language": "ts",
  "monorepo": true,
  "generateOptions": {
    "spec": false
  },
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/microservices-nestjs/tsconfig.app.json",
    "webpack": true,
    "assets": [
      {
        "include": "src/infrastructure/config/environments/**/*",
        "outDir": "dist/src/infrastructure/config/environments"
      }
    ],
    "watchAssets": false,
    "plugins": []
  },
  "root": "apps/microservices-nestjs",
  "projects": {
    "maintenance-service": {
      "type": "application",
      "root": "apps/maintenance-service",
      "entryFile": "start",
      "sourceRoot": "apps/maintenance-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/maintenance-service/tsconfig.app.json"
      }
    },
    "microservices-nestjs": {
      "type": "application",
      "root": "apps/microservices-nestjs",
      "entryFile": "start",
      "sourceRoot": "apps/microservices-nestjs/src",
      "compilerOptions": {
        "tsConfigPath": "apps/microservices-nestjs/tsconfig.app.json"
      }
    },
    "operations-service": {
      "type": "application",
      "root": "apps/operations-service",
      "entryFile": "start",
      "sourceRoot": "apps/operations-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/operations-service/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}